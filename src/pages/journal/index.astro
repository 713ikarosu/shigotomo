---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'

const articles = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const formatDate = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`
---

<Layout
  title="ジャーナル｜シゴトモ"
  description="社会人の学習継続・習慣化のヒントを届けるシゴトモのジャーナル。「勉強が続かない」を仕組みで解決するための読みものです。"
>
  <header class="journalHeader">
    <a href="/" class="logo">シゴトモ</a>
    <a href="/" class="back">サービスを見る →</a>
  </header>

  <main class="journalMain">
    <div class="container">
      <div class="sectionHeader">
        <h1 class="sectionTitle">
          <span class="titleEn">Journal</span>
          <span class="titleJa">シゴトモジャーナル</span>
        </h1>
        <p class="lead">
          「勉強が続かない」を根性ではなく仕組みで解決するための読みもの。<br />
          社会人の学習継続・習慣化のヒントを届けます。
        </p>
      </div>

      <div class="articleList">
        {
          articles.map((article) => (
            <a href={`/journal/${article.id}/`} class="articleCard">
              <div class="articleMeta">
                <time datetime={article.data.publishDate.toISOString()}>
                  {formatDate(article.data.publishDate)}
                </time>
                {article.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h2 class="articleTitle">{article.data.title}</h2>
              <p class="articleDescription">{article.data.description}</p>
              <span class="readMore">読む →</span>
            </a>
          ))
        }
      </div>

      {articles.length === 0 && <p class="empty">記事は準備中です。</p>}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .journalHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 2rem;
    border-bottom: 1px solid rgba(30, 58, 95, 0.1);
    background: var(--color-shiro);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .logo {
    font-family: var(--font-serif), serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-ai);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .back {
    font-family: var(--font-sans), sans-serif;
    font-size: 0.9rem;
    color: var(--color-usuzumi);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .back:hover {
    color: var(--color-ai);
  }

  .journalMain {
    min-height: 70vh;
    padding: var(--space-xl) 0;
    background: var(--color-kinari);
  }

  .sectionHeader {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .sectionTitle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .titleEn {
    font-family: var(--font-serif), serif;
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-shu);
    font-weight: 400;
  }

  .titleJa {
    font-family: var(--font-serif), serif;
    font-size: 2.5rem;
    color: var(--color-ai-deep);
    font-weight: 700;
    position: relative;
    padding-bottom: 1rem;
  }

  .titleJa::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: var(--color-shu);
  }

  .lead {
    margin-top: var(--space-md);
    color: var(--color-usuzumi);
    line-height: 2;
  }

  .articleList {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 760px;
    margin: 0 auto;
  }

  .articleCard {
    display: block;
    background: var(--color-shiro);
    border: 1px solid rgba(30, 58, 95, 0.1);
    border-radius: 8px;
    padding: var(--space-md);
    text-decoration: none;
    transition: all 0.3s var(--transition-smooth);
  }

  .articleCard:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .articleMeta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-usuzumi);
  }

  .tag {
    background: var(--color-kinari);
    color: var(--color-ai);
    padding: 0.15rem 0.6rem;
    border-radius: 3px;
    font-size: 0.78rem;
  }

  .articleTitle {
    font-family: var(--font-serif), serif;
    font-size: 1.35rem;
    color: var(--color-ai-deep);
    font-weight: 700;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .articleDescription {
    color: var(--color-usuzumi);
    font-size: 0.95rem;
    line-height: 1.9;
    margin-bottom: 0.75rem;
  }

  .readMore {
    font-size: 0.9rem;
    color: var(--color-shu);
    font-weight: 500;
  }

  .empty {
    text-align: center;
    color: var(--color-usuzumi);
  }

  @media (max-width: 768px) {
    .journalHeader {
      padding: 0.9rem 1.25rem;
    }

    .titleJa {
      font-size: 1.8rem;
    }

    .lead br {
      display: none;
    }
  }
</style>
