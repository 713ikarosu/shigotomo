---
import styles from './FlowAndFAQ.module.css'

const steps = [
  { number: '01', title: '無料の学習コミュニティに参加', description: 'まずはLINEのオープンチャット（無料の学習コミュニティ）に参加するだけ。参加は無料で、この時点でお申し込みにはなりません。続け方のヒントや、記事の先行公開を受け取れます。' },
  { number: '02', title: '個別の無料面談（LINE通話）', description: 'もっと本格的に伴走してほしくなったら、個別の無料面談へ。20〜30分で現状・目標・生活リズムをうかがい、続けられる形を一緒に探します。面談も無料で、お申し込みではありません。' },
  { number: '03', title: 'プランのお申し込み・学習計画の作成', description: '面談で相互に「合いそう」と感じた方にのみ、有料プランをご案内します。お申し込み（決済）のあと、「毎日やること」が明確なあなた専用の学習計画を作成・共有します。' },
  { number: '04', title: '伴走スタート', description: '毎日の学習報告と、週1回の進捗チェックで、続く形に一緒に整えていきます。' },
]
---

<section id="flow" class={styles.flow}>
  <div class="container">
    <div class={styles.sectionHeader} data-animate>
      <h2 class={styles.sectionTitle}>
        <span class={styles.titleEn}>Flow</span>
        <span class={styles.titleJa}>ご利用の流れ</span>
      </h2>
    </div>

    <div class={styles.flowSteps}>
      {steps.map((step, index) => (
        <>
          <div
            class={styles.flowStep}
            data-animate
            data-delay={String(0.2 + index * 0.1)}
          >
            <div class={styles.stepNumber}>{step.number}</div>
            <div class={styles.stepContent}>
              <h4>{step.title}</h4>
              <p>{step.description}</p>
            </div>
          </div>
          {index < steps.length - 1 && (
            <div class={styles.flowArrow} data-animate data-delay={String(0.3 + index * 0.1)} />
          )}
        </>
      ))}
    </div>
  </div>
</section>
