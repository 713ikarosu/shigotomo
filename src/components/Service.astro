---
import styles from './Service.module.css'

const features = [
  {
    icon: '📋',
    title: '学習計画の設計',
    description: 'あなたの目標・現状・生活リズムに合わせた、無理のない月次学習計画を作成します。',
  },
  {
    icon: '📅',
    title: '毎日の習慣化支援',
    description: '日々の学習報告を通じて、学習習慣の定着をサポート。継続する力を育てます。',
  },
  {
    icon: '📊',
    title: '週次進捗チェック',
    description: '週1回の進捗確認で、計画の調整や簡易フィードバックを提供。軌道修正を支援します。',
  },
  {
    icon: '🤝',
    title: '医師×教育の視点',
    description: '医師と元教師が設計に関与。「なぜ忙しい人ほど学習が続かないか」を行動・生活習慣の視点で分析し、根性に頼らない継続の仕組みをつくります。',
  },
]
---

<section id="service" class={styles.service}>
  <div class="container">
    <div class={styles.sectionHeader} data-animate>
      <h2 class={styles.sectionTitle}>
        <span class={styles.titleEn}>Service</span>
        <span class={styles.titleJa}>サービスについて</span>
      </h2>
    </div>

    <div class={styles.servicePhilosophy} data-animate data-delay="0.2">
      <div class={styles.philosophyCard}>
        <h3>「教える」のではなく、<br />「設計する」</h3>
        <p>モチベーション論は扱いません。精神論・根性論も扱いません。</p>
        <p>
          シゴトモは、あなたの目標・生活リズム・現状を把握したうえで、
          無理なく続けられる学習計画を設計し、毎日の進捗を管理します。
          「続けられる仕組み」を外側から整えることが、私たちの役割です。
        </p>
        <p>
          このサービスは「根性で頑張りたい人」には向いていません。
          仕組みと設計で着実に進みたい人のための、伴走型支援です。
        </p>
      </div>
    </div>

    <div class={styles.serviceFeatures}>
      {features.map((feature, index) => (
        <div
          class={styles.featureCard}
          data-animate
          data-delay={String(0.4 + index * 0.1)}
        >
          <div class={styles.featureIcon}>{feature.icon}</div>
          <h4>{feature.title}</h4>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>

    <div class={styles.serviceAbout} data-animate data-delay="0.2">
      <div class={styles.aboutCard}>
        <div class={styles.aboutLabel}>運営者について</div>

        <div class={styles.aboutPerson}>
          <div class={styles.personRole}>代表・伴走担当</div>
          <p class={styles.personName}>つっちゃん先生</p>
          <p>
            元小学校教師。子どもたちと向き合う中で気づいた——「勉強が続くかどうかは、能力より仲間の問題だ」と。
            社会人になると、同じ目標に向かう仲間ができにくい。だからこそ、あなたの隣で一緒に進む存在が必要だと思い、シゴトモを立ち上げた。
          </p>
        </div>

        <hr class={styles.personDivider} />

        <div class={styles.aboutPerson}>
          <div class={styles.personRole}>学習設計担当・医師</div>
          <p>
            大学時代から中学・高校・大学受験生の勉強を指導。
            自身も「才能より計画」で医師国試を突破した経験から、勉強設計の専門家として活動。
            土地家屋調査士（合格・独立）など、社会人の資格学習の伴走実績あり。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
