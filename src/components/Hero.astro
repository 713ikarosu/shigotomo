---
import styles from './Hero.module.css'
import { RECRUITING_OPEN } from '../config'

const catchphrase = ['明', '日', 'の', '仕', '事', 'に', '、']
const mainText = [
  { char: '伴', isMain: true },
  { char: 'が', isMain: false },
  { char: 'い', isMain: false },
  { char: 'る', isMain: false },
]
---

<section class={styles.hero}>
  <picture class={styles.heroBg}>
    <source srcset="/hero.avif" type="image/avif" />
    <source srcset="/hero.webp" type="image/webp" />
    <img
      src="/hero.png"
      alt=""
      fetchpriority="high"
      decoding="async"
      class={styles.heroBgImg}
    />
  </picture>

  <div class={styles.heroContainer}>
    <div class={styles.heroVerticalText}>
      <h1 class={styles.verticalCatchphrase}>
        {catchphrase.map((char) => (
          <span class={styles.char}>{char}</span>
        ))}
      </h1>
      <h1 class={styles.verticalMain}>
        {mainText.map((item) => (
          item.isMain ? (
            <span class={styles.charTomo}>
              <ruby>{item.char}<rt>とも</rt></ruby>
            </span>
          ) : (
            <span class={styles.charSmall}>{item.char}</span>
          )
        ))}
      </h1>
    </div>

    <div class={styles.heroContent}>
      <p class={styles.heroSubtitle}>
        社会人になってから、<br />
        一緒に勉強してくれる人はいたか
      </p>

      <div class={styles.heroDescription}>
        <p>
          やる気の出し方も、根性論も、扱いません。<br />
          シゴトモがそばに立って整えるのは、毎日の習慣・進捗、<br class="sp-only" />そして学習計画。<br />
          「今日やること」が毎日決まっている状態をつくります。
        </p>
      </div>

      <div class={styles.heroCta}>
        {RECRUITING_OPEN && (
          <a href="#apply" class={`${styles.btn} ${styles.btnPrimary}`}>
            <span>無料ではじめる</span>
            <span class={styles.btnNote}>※少人数制</span>
          </a>
        )}
        <a href="#service" class={`${styles.btn} ${styles.btnSecondary}`}>
          サービス詳細
        </a>
      </div>
    </div>
  </div>
  <div class={styles.heroDecoration}></div>
</section>
