---
import styles from './Plan.module.css'

const features = [
  {
    title: '初回ヒアリング',
    desc: 'LINE通話（20〜30分）で目標・生活状況・学習環境を確認します',
  },
  {
    title: '月次学習計画作成',
    desc: '「毎日、今日やること」が分かる形でプランを設計・共有します',
  },
  {
    title: '毎日の学習報告',
    desc: '1分でできるフォーム報告。習慣化の継続を管理します',
  },
  {
    title: '週1回の進捗チェック',
    desc: '達成度コメントと翌週の改善ポイントを提示します',
  },
]
---

<section id="plan" class={styles.plan}>
  <div class="container">
    <div class={styles.sectionHeader} data-animate>
      <h2 class={styles.sectionTitle}>
        <span class={styles.titleEn}>Plan</span>
        <span class={styles.titleJa}>料金プラン</span>
      </h2>
    </div>

    <div class={styles.planCard} data-animate data-delay="0.2">
      <div class={styles.planBadge}>現在ローンチ中</div>
      <div class={styles.planHeader}>
        <h3>ライトプラン</h3>
        <div class={styles.planPrice}>
          <span class={styles.priceAmount}>2,980</span>
          <span class={styles.priceUnit}>円/月（税込）</span>
        </div>
      </div>

      <div class={styles.planLimit}>
        <p>⚠️ 人数制限あり(15〜20名まで)</p>
      </div>

      <div class={styles.planContent}>
        <h4>提供内容</h4>
        <ul class={styles.planFeatures}>
          {features.map((feature) => (
            <li>
              <span class={styles.featureTitle}>{feature.title}</span>
              <span class={styles.featureDesc}>{feature.desc}</span>
            </li>
          ))}
        </ul>

        <div class={styles.planNote}>
          <p><strong>※ 問題の解説・添削・質問対応・毎日フィードバック・電話/ビデオ通話は対象外です</strong></p>
          <p>ライトプランは「習慣化と計画管理」に特化したプランです。<br />勉強が続く仕組みをつくることにフォーカスします。</p>
        </div>

        <div class={styles.planBilling}>
          <h4>月額請求ルール</h4>
          <dl class={styles.billingTable}>
            <div class={styles.billingRow}>
              <dt>利用開始日</dt>
              <dd>初回決済日</dd>
            </div>
            <div class={styles.billingRow}>
              <dt>1ヶ月の定義</dt>
              <dd>初回決済日〜翌月同日の前日</dd>
            </div>
            <div class={styles.billingRow}>
              <dt>自動更新</dt>
              <dd>あり（更新前の個別通知なし）</dd>
            </div>
            <div class={styles.billingRow}>
              <dt>解約期限</dt>
              <dd>次回更新日の前日まで</dd>
            </div>
            <div class={styles.billingRow}>
              <dt>解約方法</dt>
              <dd>Stripe上からご自身でお手続き（運営への連絡不要）</dd>
            </div>
            <div class={styles.billingRow}>
              <dt>日割り・返金</dt>
              <dd>なし</dd>
            </div>
          </dl>
          <p class={styles.billingNote}><a href="/terms">利用規約・キャンセルポリシー全文はこちら</a></p>
        </div>

        <div class={styles.planFuture}>
          <h5>今後予定のプラン</h5>
          <p class={styles.futureNote}>
            ライトプランで一定期間継続できた方を対象に、<br />
            毎日フィードバック・週1面談を含む<strong>プレミアムプラン</strong>を招待制で提供予定です。
          </p>
        </div>
      </div>

      <div class={styles.planCta}>
        <a href="#apply" class={styles.btnPrimary}>
          <span>ライトプランに申し込む</span>
        </a>
      </div>
    </div>
  </div>
</section>
